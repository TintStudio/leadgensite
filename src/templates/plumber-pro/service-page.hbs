<!-- Service Page Template -->
<section class="hero">
  <div class="container hero-content">
    <span class="hero-badge">Plumbing Service</span>
    <h1>{{content.hero.headline}}</h1>
    <p>{{content.hero.subheadline}}</p>
    <div class="hero-actions">
      <a href="{{phoneLink project.phone}}" class="btn btn-primary">{{content.hero.cta_button_text}} ({{project.phone}})</a>
      <a href="/contact" class="btn btn-outline">Request Plumbing Quote</a>
    </div>
  </div>
</section>

<!-- Introduction -->
<section class="section">
  <div class="container">
    <div style="max-width: 800px; margin: 0 auto;">
      <h2 style="font-size: 28px; margin-bottom: 20px; color: var(--secondary);">{{content.introduction.heading}}</h2>
      <p style="font-size: 16px; color: var(--text); line-height: 1.8;">{{content.introduction.content}}</p>
    </div>
  </div>
</section>

<!-- Process Steps -->
<section class="section section-alt">
  <div class="container">
    <div class="section-title">
      <h2>Our Plumbing Repair &amp; Service Process</h2>
      <p>How our licensed plumbing technicians handle your service request from call to completion.</p>
    </div>
    <div class="grid-2">
      {{#each content.process_steps}}
      <div class="card">
        <span style="display: inline-block; background: var(--primary); color: #ffffff; width: 28px; height: 28px; border-radius: 50%; text-align: center; line-height: 28px; font-weight: bold; font-size: 13px; margin-bottom: 12px;">{{this.step_number}}</span>
        <h3>{{this.title}}</h3>
        <p>{{this.description}}</p>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- Benefits -->
<section class="section">
  <div class="container">
    <div class="section-title">
      <h2>Why Hire Our Professional Plumbers</h2>
      <p>Guaranteed workmanship, licensed plumbing masters, and transparent pricing.</p>
    </div>
    <div class="grid-2">
      {{#each content.benefits}}
      <div class="card" style="border-left: 4px solid var(--primary);">
        <h3>{{this.title}}</h3>
        <p>{{this.description}}</p>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- Common Problems Solved -->
<section class="section section-alt">
  <div class="container">
    <div class="section-title">
      <h2>Common Plumbing Issues We Fix</h2>
    </div>
    <div class="grid-3">
      {{#each content.common_problems_solved}}
      <div class="card">
        <p style="font-weight: 600; color: var(--secondary);">✓ {{this}}</p>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- Service FAQs -->
<section class="section">
  <div class="container">
    <div class="section-title">
      <h2>Questions About This Service</h2>
    </div>
    <div style="max-width: 800px; margin: 0 auto;">
      {{#each content.faqs}}
      <div class="faq-item">
        <h4>{{this.question}}</h4>
        <p>{{this.answer}}</p>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- CTA Banner -->
<section class="cta-banner">
  <div class="container">
    <h2>{{content.cta_banner.headline}}</h2>
    <p>{{content.cta_banner.subheadline}}</p>
    <a href="{{phoneLink project.phone}}" class="btn btn-primary" style="background: #ffffff; color: var(--secondary); font-size: 16px;">
      {{content.cta_banner.button_text}} ({{project.phone}})
    </a>
  </div>
</section>
