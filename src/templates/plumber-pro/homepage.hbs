<!-- Hero Section -->
<section class="hero">
  <div class="container hero-content">
    <span class="hero-badge">Professional Plumbing Services</span>
    <h1>{{content.hero.headline}}</h1>
    <p>{{content.hero.subheadline}}</p>
    <div class="hero-actions">
      <a href="{{phoneLink project.phone}}" class="btn btn-primary">{{content.hero.cta_button_text}} ({{project.phone}})</a>
      <a href="/contact" class="btn btn-outline">Request Online Quote</a>
    </div>
  </div>
</section>

<!-- Services Section -->
<section id="services" class="section">
  <div class="container">
    <div class="section-title">
      <h2>{{content.services_overview.heading}}</h2>
      <p>{{content.services_overview.subheading}}</p>
    </div>
    <div class="grid-3">
      {{#each content.services_overview.featured_services}}
      <div class="card">
        <h3>{{this.title}}</h3>
        <p>{{this.short_description}}</p>
        <div style="margin-top: 16px;">
          <a href="/services/{{this.slug}}" style="color: var(--primary); font-weight: 600; font-size: 13px;">View Service Details &rarr;</a>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- About Section -->
<section id="about" class="section section-alt">
  <div class="container">
    <div class="section-title">
      <h2>{{content.about.heading}}</h2>
      <p>{{content.about.story}}</p>
    </div>
    <div class="grid-2">
      {{#each content.about.bullet_points}}
      <div class="card" style="border-left: 4px solid var(--primary);">
        <p style="color: var(--secondary); font-weight: 600;">✓ {{this}}</p>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- Why Choose Us -->
<section class="section">
  <div class="container">
    <div class="section-title">
      <h2>{{content.why_choose_us.heading}}</h2>
    </div>
    <div class="grid-2">
      {{#each content.why_choose_us.features}}
      <div class="card">
        <h3>{{this.title}}</h3>
        <p>{{this.description}}</p>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- Service Areas Section -->
<section id="areas" class="section section-alt">
  <div class="container">
    <div class="section-title">
      <h2>Plumbing Service Coverage</h2>
      <p>Providing fast emergency plumbing dispatch across all local neighborhoods and surrounding cities.</p>
    </div>
    <div class="grid-3">
      {{#each areasList}}
      <div class="card">
        <h3>{{this.name}}</h3>
        <p>Complete residential &amp; commercial plumbing services dispatched directly to {{this.name}}.</p>
        <div style="margin-top: 12px;">
          <a href="/areas/{{this.slug}}" style="color: var(--primary); font-weight: 600; font-size: 13px;">View Area Coverage &rarr;</a>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- FAQs Section -->
<section class="section">
  <div class="container">
    <div class="section-title">
      <h2>Frequently Asked Questions</h2>
      <p>Common questions about our plumbing repairs, pricing, and emergency response.</p>
    </div>
    <div style="max-width: 800px; margin: 0 auto;">
      {{#each content.faqs}}
      <div class="faq-item">
        <h4>{{this.question}}</h4>
        <p>{{this.answer}}</p>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- CTA Banner -->
<section class="cta-banner">
  <div class="container">
    <h2>{{content.cta_banner.headline}}</h2>
    <p>{{content.cta_banner.subheadline}}</p>
    <a href="{{phoneLink project.phone}}" class="btn btn-primary" style="background: #ffffff; color: var(--secondary); font-size: 16px;">
      {{content.cta_banner.button_text}} ({{project.phone}})
    </a>
  </div>
</section>
