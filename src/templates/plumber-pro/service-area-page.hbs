<!-- Service Area Page Template -->
<section class="hero">
  <div class="container hero-content">
    <span class="hero-badge">Local Plumbing Dispatch</span>
    <h1>{{content.hero.headline}}</h1>
    <p>{{content.hero.subheadline}}</p>
    <div class="hero-actions">
      <a href="{{phoneLink project.phone}}" class="btn btn-primary">{{content.hero.cta_button_text}} ({{project.phone}})</a>
      <a href="/contact" class="btn btn-outline">Schedule Plumbing Service</a>
    </div>
  </div>
</section>

<!-- Local Context -->
<section class="section">
  <div class="container">
    <div style="max-width: 800px; margin: 0 auto;">
      <h2 style="font-size: 28px; margin-bottom: 16px; color: var(--secondary);">{{content.local_context.heading}}</h2>
      <p style="font-size: 16px; line-height: 1.8; margin-bottom: 20px;">{{content.local_context.area_summary}}</p>
      <div class="card" style="border-left: 4px solid var(--primary); background: var(--surface);">
        <p style="font-weight: 500; color: var(--secondary);">{{content.local_context.local_relevance}}</p>
      </div>
    </div>
  </div>
</section>

<!-- Services Offered in Area -->
<section class="section section-alt">
  <div class="container">
    <div class="section-title">
      <h2>Plumbing Services Delivered Locally</h2>
      <p>Full suite of plumbing and drain solutions available to residents and commercial facilities.</p>
    </div>
    <div class="grid-3">
      {{#each content.services_offered}}
      <div class="card">
        <h3>{{this.service_name}}</h3>
        <p>{{this.description}}</p>
        <div style="margin-top: 12px;">
          <a href="/services/{{this.slug}}" style="color: var(--primary); font-weight: 600; font-size: 13px;">Learn More &rarr;</a>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- Response Guarantee -->
<section class="section">
  <div class="container">
    <div style="max-width: 750px; margin: 0 auto; text-align: center;">
      <h2 style="font-size: 26px; color: var(--secondary); margin-bottom: 12px;">{{content.response_guarantee.title}}</h2>
      <p style="font-size: 16px; color: var(--text-muted); line-height: 1.7;">{{content.response_guarantee.description}}</p>
      <div style="margin-top: 24px;">
        <a href="{{phoneLink project.phone}}" class="btn btn-primary">Call Now for Immediate Dispatch ({{project.phone}})</a>
      </div>
    </div>
  </div>
</section>

<!-- Area FAQs -->
<section class="section section-alt">
  <div class="container">
    <div class="section-title">
      <h2>Local Service FAQs</h2>
    </div>
    <div style="max-width: 800px; margin: 0 auto;">
      {{#each content.faqs}}
      <div class="faq-item">
        <h4>{{this.question}}</h4>
        <p>{{this.answer}}</p>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- CTA Banner -->
<section class="cta-banner">
  <div class="container">
    <h2>{{content.cta_banner.headline}}</h2>
    <p>{{content.cta_banner.subheadline}}</p>
    <a href="{{phoneLink project.phone}}" class="btn btn-primary" style="background: #ffffff; color: var(--secondary); font-size: 16px;">
      {{content.cta_banner.button_text}} ({{project.phone}})
    </a>
  </div>
</section>
