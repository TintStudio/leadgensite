<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{meta_title}}</title>
  <meta name="description" content="{{meta_description}}">
  <link rel="canonical" href="https://{{project.domain}}/{{slug}}">
  <link rel="stylesheet" href="/style.css">
  <script type="application/ld+json">
  {{{schemaJson}}}
  </script>
</head>
<body>
  <!-- Top Emergency Dispatch Bar -->
  <div class="top-bar">
    <div class="container">
      <span>Licensed Master Plumbers • Fast Emergency Dispatch</span>
      <span>24/7 Phone: <a href="{{phoneLink project.phone}}">{{project.phone}}</a></span>
    </div>
  </div>

  <!-- Header -->
  <header>
    <div class="container">
      <div class="nav-wrap">
        <a href="/" class="logo">
          <span>{{project.business_name}}</span>
          <span class="logo-badge">Plumbing</span>
        </a>
        <nav>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/#services">Services</a></li>
            <li><a href="/#areas">Service Areas</a></li>
            <li><a href="/#about">About Us</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="{{phoneLink project.phone}}" class="btn btn-primary">Call {{project.phone}}</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </header>

  <!-- Main Body Content Injected Here -->
  <main>
    {{{body}}}
  </main>

  <!-- Footer -->
  <footer>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <h4>{{project.business_name}}</h4>
          <p>{{project.description}}</p>
          <p style="margin-top: 12px; font-weight: 600;">Call: <a href="{{phoneLink project.phone}}">{{project.phone}}</a></p>
        </div>
        <div class="footer-col">
          <h4>Plumbing Services</h4>
          <ul>
            {{#each servicesList}}
            <li><a href="/services/{{this.slug}}">{{this.name}}</a></li>
            {{/each}}
          </ul>
        </div>
        <div class="footer-col">
          <h4>Service Areas</h4>
          <ul>
            {{#each areasList}}
            <li><a href="/areas/{{this.slug}}">{{this.name}}</a></li>
            {{/each}}
          </ul>
        </div>
        <div class="footer-col">
          <h4>Operating Hours</h4>
          <p>Monday - Sunday: 24 Hours Emergency Service</p>
          <p style="margin-top: 8px;">Address: {{project.address}}, {{project.city}}, {{project.state}} {{project.zip}}</p>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {{currentYear}} {{project.business_name}}. All rights reserved. | <a href="/contact">Contact Us</a> | <a href="/sitemap.xml">Sitemap</a></p>
      </div>
    </div>
  </footer>
</body>
</html>
