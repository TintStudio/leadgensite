<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{meta_title}}</title>
  <meta name="description" content="{{meta_description}}">
  <link rel="canonical" href="https://{{project.domain}}/{{slug}}">
  <link rel="stylesheet" href="/style.css">
  <script type="application/ld+json">
  {{{schemaJson}}}
  </script>
</head>
<body>
  <!-- Urgent Disaster Response Banner -->
  <div class="dispatch-banner">
    🚨 ACTIVE DISASTER RESPONSE: 60-Minute Emergency On-Site Dispatch Guarantee • Direct Insurance Billing Assistance •
    <a href="{{phoneLink project.phone}}">CALL EMERGENCY DISPATCH: {{project.phone}}</a>
  </div>

  <!-- Header -->
  <header>
    <div class="container">
      <div class="nav-wrap">
        <a href="/" class="logo">
          <span>{{project.business_name}}</span>
          <span class="logo-badge">Restoration</span>
        </a>
        <nav>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/#services">Restoration Services</a></li>
            <li><a href="/#areas">Coverage Areas</a></li>
            <li><a href="/#about">About Us</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="{{phoneLink project.phone}}" class="btn btn-emergency">Call {{project.phone}}</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </header>

  <!-- Metric Strip -->
  <div class="metrics-strip">
    <div class="container metrics-grid">
      <div>
        <div class="metric-number">60 MIN</div>
        <div class="metric-label">Average Emergency Arrival Time</div>
      </div>
      <div>
        <div class="metric-number">24 / 7 / 365</div>
        <div class="metric-label">Rapid Dispatch Available Always</div>
      </div>
      <div>
        <div class="metric-number">100%</div>
        <div class="metric-label">Direct Insurance Claim Billing</div>
      </div>
      <div>
        <div class="metric-number">CERTIFIED</div>
        <div class="metric-label">IICRC Trained Restoration Masters</div>
      </div>
    </div>
  </div>

  <main>
    {{{body}}}
  </main>

  <!-- Footer -->
  <footer>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <h4>{{project.business_name}}</h4>
          <p>{{project.description}}</p>
          <p style="margin-top: 14px; font-weight: 700; color: #f87171;">Emergency Hotline: <a href="{{phoneLink project.phone}}" style="color: #ffffff;">{{project.phone}}</a></p>
        </div>
        <div class="footer-col">
          <h4>Restoration Services</h4>
          <ul>
            {{#each servicesList}}
            <li><a href="/services/{{this.slug}}">{{this.name}}</a></li>
            {{/each}}
          </ul>
        </div>
        <div class="footer-col">
          <h4>Emergency Coverage Areas</h4>
          <ul>
            {{#each areasList}}
            <li><a href="/areas/{{this.slug}}">{{this.name}}</a></li>
            {{/each}}
          </ul>
        </div>
        <div class="footer-col">
          <h4>Emergency Headquarters</h4>
          <p>Dispatched 24 Hours Daily</p>
          <p style="margin-top: 8px;">Address: {{project.address}}, {{project.city}}, {{project.state}} {{project.zip}}</p>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {{currentYear}} {{project.business_name}}. All rights reserved. | <a href="/contact">Emergency Contact</a> | <a href="/sitemap.xml">XML Sitemap</a></p>
      </div>
    </div>
  </footer>
</body>
</html>
