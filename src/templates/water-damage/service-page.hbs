<!-- Water Damage Service Page Template -->
<section class="hero">
  <div class="container hero-content">
    <span class="alert-tag">DISASTER MITIGATION SERVICE</span>
    <h1>{{content.hero.headline}}</h1>
    <p>{{content.hero.subheadline}}</p>
    <div class="hero-actions">
      <a href="{{phoneLink project.phone}}" class="btn btn-emergency">{{content.hero.cta_button_text}} ({{project.phone}})</a>
      <a href="/contact" class="btn btn-outline">Schedule Damage Assessment</a>
    </div>
  </div>
</section>

<!-- Overview -->
<section class="section">
  <div class="container">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="font-size: 30px; margin-bottom: 20px; color: var(--secondary); font-weight: 800;">{{content.introduction.heading}}</h2>
      <p style="font-size: 17px; color: var(--text); line-height: 1.8;">{{content.introduction.content}}</p>
    </div>
  </div>
</section>

<!-- Restoration Steps -->
<section class="section section-alt">
  <div class="container">
    <div class="section-title">
      <h2>Step-by-Step Restoration Protocol</h2>
      <p>Industry-certified procedure using commercial air movers, dehumidifiers, and thermal imaging.</p>
    </div>
    <div class="grid-2">
      {{#each content.process_steps}}
      <div class="card" style="border-top: 3px solid var(--primary);">
        <span style="display: inline-block; background: var(--primary); color: #ffffff; width: 28px; height: 28px; border-radius: 50%; text-align: center; line-height: 28px; font-weight: 800; font-size: 13px; margin-bottom: 12px;">{{this.step_number}}</span>
        <h3>{{this.title}}</h3>
        <p>{{this.description}}</p>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- Benefits -->
<section class="section">
  <div class="container">
    <div class="section-title">
      <h2>Why Professional Mitigation Matters</h2>
      <p>Prevent toxic mold outbreaks, permanent wood rot, and structural degradation.</p>
    </div>
    <div class="grid-2">
      {{#each content.benefits}}
      <div class="card" style="border-left: 4px solid var(--primary);">
        <h3>{{this.title}}</h3>
        <p>{{this.description}}</p>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- Common Problems Solved -->
<section class="section section-alt">
  <div class="container">
    <div class="section-title">
      <h2>Disaster Damages Mitigated</h2>
    </div>
    <div class="grid-3">
      {{#each content.common_problems_solved}}
      <div class="card">
        <p style="font-weight: 700; color: var(--secondary);">✓ {{this}}</p>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- FAQs -->
<section class="section">
  <div class="container">
    <div class="section-title">
      <h2>Restoration Questions &amp; Answers</h2>
    </div>
    <div style="max-width: 820px; margin: 0 auto;">
      {{#each content.faqs}}
      <div class="faq-item">
        <h4>{{this.question}}</h4>
        <p>{{this.answer}}</p>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- Emergency CTA -->
<section class="cta-banner">
  <div class="container">
    <h2>{{content.cta_banner.headline}}</h2>
    <p>{{content.cta_banner.subheadline}}</p>
    <a href="{{phoneLink project.phone}}" class="btn btn-outline" style="background: #ffffff; color: var(--primary); font-size: 16px; border: none; font-weight: 800;">
      {{content.cta_banner.button_text}} ({{project.phone}})
    </a>
  </div>
</section>
