<!-- Water Damage Blog Post Template -->
<article class="section">
  <div class="container" style="max-width: 820px;">
    <span class="alert-tag">EMERGENCY GUIDES &amp; INSURANCE TIPS</span>
    <h1 style="font-size: 38px; font-weight: 900; color: var(--secondary); margin-bottom: 14px; line-height: 1.3;">{{content.title}}</h1>
    <div style="font-size: 14px; color: var(--text-muted); margin-bottom: 26px;">
      <span>Estimated reading time: {{content.read_time}}</span> • <span>Published by Disaster Response Team</span>
    </div>

    <!-- Excerpt -->
    <div class="card" style="border-left: 4px solid var(--primary); margin-bottom: 38px; background: var(--surface-alt);">
      <p style="font-size: 17px; font-style: italic; color: var(--secondary); line-height: 1.6;">{{content.excerpt}}</p>
    </div>

    <!-- Article Content -->
    <div class="article-content" style="font-size: 17px; line-height: 1.8; color: var(--text);">
      {{#each content.sections}}
      <div style="margin-bottom: 38px;">
        <h2 style="font-size: 26px; font-weight: 800; color: var(--secondary); margin-bottom: 16px;">{{this.heading}}</h2>
        {{#each this.paragraphs}}
        <p style="margin-bottom: 16px;">{{this}}</p>
        {{/each}}
      </div>
      {{/each}}
    </div>

    <!-- Conclusion -->
    <div class="card" style="margin-top: 40px; background: var(--surface);">
      <h3 style="margin-bottom: 10px; font-size: 20px;">Key Takeaway &amp; Prevention Advice</h3>
      <p>{{content.conclusion}}</p>
    </div>

    <!-- Urgent Dispatch Notice -->
    <div class="card" style="margin-top: 36px; border: 2px solid var(--primary); text-align: center; padding: 36px; background: var(--surface-alt);">
      <h3 style="font-size: 24px; margin-bottom: 10px; color: var(--primary);">Facing Active Water Damage Right Now?</h3>
      <p style="margin-bottom: 24px; font-size: 16px;">Every minute counts to stop toxic mold growth. Contact our 24/7 disaster extraction team immediately.</p>
      <a href="{{phoneLink project.phone}}" class="btn btn-emergency">Call Dispatch Now: {{project.phone}}</a>
    </div>
  </div>
</article>
