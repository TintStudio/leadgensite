<!-- Water Damage Service Area Page Template -->
<section class="hero">
  <div class="container hero-content">
    <span class="alert-tag">RAPID DISASTER DISPATCH: {{content.hero.headline}}</span>
    <h1>{{content.hero.headline}}</h1>
    <p>{{content.hero.subheadline}}</p>
    <div class="hero-actions">
      <a href="{{phoneLink project.phone}}" class="btn btn-emergency">{{content.hero.cta_button_text}} ({{project.phone}})</a>
      <a href="/contact" class="btn btn-outline">Request Emergency Dispatch</a>
    </div>
  </div>
</section>

<!-- Local Area Environmental Risks -->
<section class="section">
  <div class="container">
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="font-size: 30px; margin-bottom: 16px; color: var(--secondary); font-weight: 800;">{{content.local_context.heading}}</h2>
      <p style="font-size: 17px; line-height: 1.8; margin-bottom: 24px;">{{content.local_context.area_summary}}</p>
      <div class="card" style="border-left: 4px solid var(--primary); background: var(--surface-alt);">
        <p style="font-weight: 600; color: var(--secondary);">{{content.local_context.local_relevance}}</p>
      </div>
    </div>
  </div>
</section>

<!-- Services Delivered to Territory -->
<section class="section section-alt">
  <div class="container">
    <div class="section-title">
      <h2>Emergency Disaster Services Deployed</h2>
      <p>Immediate response vehicles fully equipped with extraction and drying gear.</p>
    </div>
    <div class="grid-3">
      {{#each content.services_offered}}
      <div class="card" style="border-top: 3px solid var(--primary);">
        <h3>{{this.service_name}}</h3>
        <p>{{this.description}}</p>
        <div style="margin-top: 12px;">
          <a href="/services/{{this.slug}}" style="color: var(--primary); font-weight: 700; font-size: 13px;">View Service Specs &rarr;</a>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- Dispatch Guarantee -->
<section class="section">
  <div class="container">
    <div style="max-width: 780px; margin: 0 auto; text-align: center;">
      <h2 style="font-size: 28px; color: var(--secondary); margin-bottom: 14px; font-weight: 800;">{{content.response_guarantee.title}}</h2>
      <p style="font-size: 17px; color: var(--text-muted); line-height: 1.7;">{{content.response_guarantee.description}}</p>
      <div style="margin-top: 24px;">
        <a href="{{phoneLink project.phone}}" class="btn btn-emergency">Call Dispatch Now ({{project.phone}})</a>
      </div>
    </div>
  </div>
</section>

<!-- FAQs -->
<section class="section section-alt">
  <div class="container">
    <div class="section-title">
      <h2>Local Emergency Questions</h2>
    </div>
    <div style="max-width: 820px; margin: 0 auto;">
      {{#each content.faqs}}
      <div class="faq-item">
        <h4>{{this.question}}</h4>
        <p>{{this.answer}}</p>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- Emergency CTA -->
<section class="cta-banner">
  <div class="container">
    <h2>{{content.cta_banner.headline}}</h2>
    <p>{{content.cta_banner.subheadline}}</p>
    <a href="{{phoneLink project.phone}}" class="btn btn-outline" style="background: #ffffff; color: var(--primary); font-size: 16px; border: none; font-weight: 800;">
      {{content.cta_banner.button_text}} ({{project.phone}})
    </a>
  </div>
</section>
